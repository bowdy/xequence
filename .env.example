# Path to a Google service-account JSON key. The service account email must
# be added as an editor on the target Google Sheet.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json

# Google Sheet that holds the contact state. Either the full URL or just the ID.
XEQUENCE_SHEET_ID=

# Tab/worksheet name inside the sheet.
XEQUENCE_SHEET_TAB=contacts

# Your X handle (no @). Used to scope mutual-follow lookups.
X_HANDLE=

# Where Playwright stores the logged-in browser session. Reused on every run
# so you only have to log in once.
XEQUENCE_STORAGE_STATE=./.playwright_session/storage_state.json

# Max DMs to send in a single `send_due_messages` run. Keep low to stay under
# X's anti-spam radar.
XEQUENCE_MAX_PER_RUN=20

# Min/max seconds to wait between DMs (random jitter inside this range).
XEQUENCE_MIN_DELAY_SECONDS=35
XEQUENCE_MAX_DELAY_SECONDS=75
