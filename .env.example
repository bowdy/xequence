# Path to the SQLite database file
DATABASE_PATH=./data/xequence.db

# Path to the persistent Playwright browser profile (stores X login cookies)
PLAYWRIGHT_PROFILE=./playwright-profile

# Run the browser visibly while sending (true) or headless (false)
PLAYWRIGHT_HEADED=true

# Worker polling interval in seconds
WORKER_INTERVAL_SECONDS=30

# Minimum delay between consecutive sends (jittered up to 2x)
SEND_JITTER_MS=4000
